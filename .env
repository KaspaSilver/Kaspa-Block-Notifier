# ── kaspa-block-notifier / .env ───────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Your mining wallet address (the one that receives block rewards)
MINING_ADDRESS=
# The private key (hex) of the wallet that will SEND the KaChat notification tx.
# Keep this secret — it controls spending from that wallet.
PRIVATE_KEY_HEX=

# The KaChat alias of the account that RECEIVES the notification. It is the
# alias shown on a message you have sent -- open one in https://kaspa.stream
# and read it off there.
RECEIVER_ALIAS=

# The x-only public key of that same account: 64 hex characters, no 02/03 in
# front.
RECEIVER_PUBKEY_X=

# Network: mainnet or testnet-10
KASPA_NETWORK=mainnet

# Only send a notification if the block reward is at least this many KAS.
# Useful to filter out orphaned or very small rewards.
# Set to 0 to alert on every UTXO received.
MIN_REWARD_KAS=0

# ── Optional ──────────────────────────────────────────────────────────────────

# What the notification says. Anything in braces is filled in:
#   {reward}   the block reward, in KAS
#   {balance}  the mining address's balance afterwards, in KAS
#   {txid}     the transaction that paid the reward
#   {address}  the mining address being watched
#   {network}  mainnet or testnet-10
#   {time}     when the reward arrived, on the machine running this
# An env file cannot hold a real newline, so write \n for one.
# Leave it unset for: Reward: {reward} KAS\nBalance: {balance} KAS
MESSAGE_TEMPLATE=

